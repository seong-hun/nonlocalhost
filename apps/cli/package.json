{
  "name": "nonlocalhost",
  "version": "0.1.1",
  "private": true,
  "description": "Expose a local port through a self-hosted tunnel server.",
  "license": "MIT",
  "bin": {
    "nonlocalhost": "src/index.ts"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --outfile dist/nonlocalhost src/index.ts",
    "bundle": "bun build --target bun --outdir dist src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@nonlocalhost/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
