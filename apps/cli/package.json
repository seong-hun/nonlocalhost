{
  "name": "@nonlocalhost/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "nonlocalhost": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --outfile dist/nonlocalhost src/index.ts",
    "bundle": "bun build --target bun --outdir dist src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@nonlocalhost/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
