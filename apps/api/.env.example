PORT=3000
PUBLIC_BASE_DOMAIN=localhost
DATABASE_PATH=./data/nonlocalhost.db
JWT_SECRET=change-me-to-a-32-char-minimum-secret-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
ALLOWED_ORIGIN=http://localhost:5173

# Admin bootstrap: email:password (관리자 계정이 없을 때 자동 생성, 있으면 비밀번호 동기화)
ADMIN_SEED=you@example.com:change-me-admin-password
